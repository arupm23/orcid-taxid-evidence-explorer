# Optional but recommended for higher NCBI rate limits.
NCBI_API_KEY=

# NCBI asks API clients to identify themselves.
NCBI_TOOL=orcid-taxid-evidence-mvp
NCBI_EMAIL=you@example.org

# Defaults to instance/evidence.db inside the project.
DATABASE_PATH=

# Retrieval defaults to the offline feature-hash baseline. Set to openai to
# use semantic embeddings from the OpenAI API.
EMBEDDING_PROVIDER=local
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
